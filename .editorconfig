root = true

[*]
charset = utf-8

[*.{rs,toml,py,sh,yml,yaml,json,js,mjs,ts,css,html}]
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{rs,toml,py}]
indent_size = 4

[*.{yml,yaml,json,js,mjs,ts,css,html}]
indent_size = 2

[*.sh]
end_of_line = lf
