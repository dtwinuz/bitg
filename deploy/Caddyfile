{
	# faqat konteyner ichida (port ochilmagan): deploy.sh `caddy reload` uchun ishlatadi
	admin localhost:2019
	# grace_period ataylab yo'q: reload'da eski ulanishlar oxirigacha kutiladi (sekin yuklash uzilmaydi);
	# to'xtatish esa compose'dagi stop_grace_period bilan chegaralangan
	auto_https off
	servers {
		# dtwin edge (docker tarmog'i, xususiy IP) haqiqiy mijoz IP'sini X-Forwarded-For'da beradi
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For
		# so'rov tanasi (POST /api/feedback, /mcp) 15 s ichida kelsin; sahifa va yuklab olishlarga ta'sir qilmaydi
		timeouts {
			read_body 15s
		}
	}
}

:80 {
	# symlink: deploy.sh har relizda atomik almashtiradi
	root * /www/current
	encode zstd gzip

	# tools/site/build.py css/js manzillariga, page.js/app.js wasm'ga ?v=<sha> qo'shadi — uzoq kesh xavfsiz
	@code path /*.js /*.css /*.wasm /fonts/*
	header @code Cache-Control "public, max-age=31536000, immutable"

	@meta path /icon.svg /og.png /og/* /apple-touch-icon.png /logo-512.png /robots.txt /sitemap.xml /llms.txt
	header @meta Cache-Control "public, max-age=86400"

	@dl path /download/*
	header @dl {
		Cache-Control "public, max-age=3600"
		Content-Disposition attachment
	}

	# apt ombori: indeks tez yangilansin, paket fayllari nomida versiya bor
	@aptidx path /apt/dists/* /apt/bitg.gpg
	header @aptidx Cache-Control "no-cache"
	@aptpool path /apt/pool/*
	header @aptpool Cache-Control "public, max-age=86400"

	# pacman ombori (bitg.uz/arch): baza va kalit tez yangilansin, paket nomida versiya bor
	@archidx path /arch/bitg.asc /arch/*/bitg.db /arch/*/bitg.db.* /arch/*/bitg.files /arch/*/bitg.files.*
	header @archidx Cache-Control "no-cache"
	@archpkg path /arch/*/*.pkg.tar.zst /arch/*/*.pkg.tar.zst.sig
	header @archpkg Cache-Control "public, max-age=86400"

	# avto-yangilanish manifesti (tools/site/build.py): ilovalar kuniga bir tekshiradi, kesh yo'q
	@update path /update/*
	header @update Cache-Control "no-cache"

	@html path / /index.html /version.txt */ *.html
	header @html Cache-Control "no-cache"

	header {
		# 'wasm-unsafe-eval' — sinov maydoni bitg yadrosini WebAssembly sifatida ishga tushiradi
		# mc.yandex.* / yastatic.net — Yandex Metrica (web/metrika.js, Webvisor o'chiq)
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://mc.yandex.ru https://mc.yandex.com https://mc.yandex.uz https://yastatic.net; style-src 'self'; font-src 'self'; img-src 'self' data: https://mc.yandex.ru https://mc.yandex.com https://mc.yandex.uz; connect-src 'self' https://mc.yandex.ru https://mc.yandex.com https://mc.yandex.uz; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}

	# Kirish jurnali: faqat sahifalar, yuklab olishlar, apt va pacman. IP qisqartiriladi (/24, /48),
	# to'liq IP'li sarlavhalar o'chiriladi, 30 kundan keyin fayl o'chadi (web/pages/maxfiylik.html).
	# deploy/stats/stats.py shu jurnaldan umumiy sonlarni chiqaradi.
	@nolog {
		path /*.js /*.css /*.wasm /fonts/* /og/* /*.png /*.svg /*.ico /*.txt /*.xml /stats.json /api/* /mcp /update/*
		not path /robots.txt
	}
	log_skip @nolog
	log {
		output file /var/log/caddy/access.log {
			roll_size 20MiB
			roll_keep 40
			roll_keep_for 720h
		}
		format filter {
			fields {
				request>remote_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>client_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>headers>X-Forwarded-For delete
				request>headers>X-Real-Ip delete
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>headers>Accept delete
				request>headers>Accept-Encoding delete
				request>headers>Accept-Language delete
				request>headers>Sec-Ch-Ua delete
				request>headers>Sec-Ch-Ua-Mobile delete
				request>headers>Sec-Ch-Ua-Platform delete
				request>tls delete
				resp_headers delete
			}
		}
	}

	# ochiq hisoblagich (deploy/stats/stats.py yozadi): faqat umumiy son
	handle /stats.json {
		root * /stats-public
		header Cache-Control "public, max-age=600"
		file_server
	}

	# ochiq MCP server (bot/src/mcp.rs): AI yordamchilar uchun convert_text; login yo'q, bot o'zi cheklaydi
	handle /mcp {
		request_body {
			max_size 256KB
		}
		# Cache-Control: no-store ni bot o'zi qo'yadi (bu yerda ham qo'yilsa sarlavha ikki marta chiqadi)
		header {
			Access-Control-Allow-Origin "*"
			Access-Control-Allow-Methods "POST, OPTIONS"
			Access-Control-Allow-Headers "Content-Type, Accept, Mcp-Protocol-Version, Mcp-Session-Id"
		}
		@preflight method OPTIONS
		respond @preflight 204
		# tana to'liq kelgach uzatiladi: sekin mijoz bot ulanishini band qilmaydi
		reverse_proxy bitg-bot:8080 {
			request_buffers 256KB
		}
	}

	# MCP Registry domen tasdig'i (uz.bitg/*): ochiq kalit; maxfiy kalit repoda emas
	handle /.well-known/mcp-registry-auth {
		header Content-Type "text/plain; charset=utf-8"
		respond "v=MCPv1; k=ed25519; p=TgHaJqa9kjzFB3zf6hbk+s39p4m5siiQhSDfia/wPFg=" 200
	}

	# ilovalardan fikr (bot/src/web.rs): faqat shu yo'l, tana 3 MB gacha; bot o'zi tekshiradi va cheklaydi
	handle /api/* {
		request_body {
			max_size 3MB
		}
		# Cache-Control: no-store ni bot qo'yadi; tana to'liq kelgach uzatiladi
		reverse_proxy bitg-bot:8080 {
			request_buffers 3MB
		}
	}

	file_server

	# foydali 404: konvertor va asosiy bo'limlar havolasi, holat kodi 404 qoladi
	handle_errors 404 {
		rewrite * /404.html
		header Cache-Control "no-cache"
		file_server
	}
}
