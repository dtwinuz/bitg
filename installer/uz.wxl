  <String Id="PrivacyDlg_Title" Value="[ProductName] o'rnatuvchisi" />
  <String Id="PrivacyDlgTitle" Value="{\WixUI_Font_Title}Maxfiylik" />
  <String Id="PrivacyDlgDescription" Value="bitg qanday ma'lumot yuboradi va uni qanday o'chirish mumkin." />
  <String Id="PrivacyDlgText" Value="bitg yozgan matningizni hech qayerga yubormaydi va saqlamaydi: o'girish shu kompyuterda bo'ladi. Internetga bitta avtomatik murojaat bor: yangilanishlarni tekshirish. Yoqilgan bo'lsa, ilova kuniga bir marta bitg.uz/update/stable.json faylini (versiya raqami) o'qiydi; server so'rovni boshqa sahifalar kabi qisqartirilgan IP manzil bilan 30 kun jurnalda saqlaydi. Maxfiylik siyosati:" />
  <String Id="PrivacyDlgCheckBox" Value="&amp;Yangilanishlarni avtomatik tekshirish (bitg.uz)" />
  <String Id="PrivacyDlgCheckBoxNote" Value="Keyin ham o'zgartirish mumkin: bitg sozlamalari, Qoidalar, Ilova. Administrator: msiexec /i bitg.msi UPDATECHECK=0 yoki HKLM\SOFTWARE\Policies\bitg\UpdateCheck = 0." />
  <String Id="PrivacyDlgInstall" Value="&amp;O'rnatish" />

