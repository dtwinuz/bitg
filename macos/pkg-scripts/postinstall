#!/bin/sh
# O'rnatgandan keyin: eski nusxani to'xtatish va kirgan foydalanuvchi uchun kiritish manbasini ro'yxatdan o'tkazish.
# Xato o'rnatishni buzmaydi — foydalanuvchi Tizim sozlamalari -> Klaviatura -> Kiritish manbalari'dan o'zi qo'shadi.
APP="/Library/Input Methods/bitg.app"
/usr/bin/killall bitg 2>/dev/null || true
U="$(/usr/bin/stat -f %Su /dev/console 2>/dev/null)"
if [ -n "$U" ] && [ "$U" != "root" ] && [ "$U" != "loginwindow" ]; then
  UID_="$(/usr/bin/id -u "$U")"
  /bin/launchctl asuser "$UID_" /usr/bin/sudo -u "$U" "$APP/Contents/MacOS/bitg" --register || true
fi
exit 0
